GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=vega

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8082

# Flink
FLINK_REST=http://localhost:8081
ICEBERG_WAREHOUSE_PATH=/tmp/iceberg/warehouse
ICEBERG_CATALOG_NAME=vega_catalog
# Enable Iceberg table sinks in Flink jobs (true|false; false writes to local file sink)
VEGA_ICEBERG_ENABLED=false
VEGA_DLQ_TOPIC=vega-dead-letter
VEGA_FLINK_PARALLELISM=2

# Dead-letter queue topic for connector parse/source failures (default: vega-dead-letter)
VEGA_DLQ_TOPIC=vega-dead-letter

# Databricks (dbt)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Azure (production)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ACR_LOGIN_SERVER=
FLINK_CHECKPOINT_ACCOUNT=
FLINK_CHECKPOINT_CONTAINER=
